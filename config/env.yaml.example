# WhatsApp Invoice Assistant Configuration

# Database Configuration (Supabase only)
database:
  # Option 1: Direct Database URL (will be used if provided)
  database_url: "postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres"

  # Option 2: Alternative connection options (uncomment one if needed)
  # Direct format alternative
  # supabase_database_url: "postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres"
  # Pooled connection format (session pool)
  # supabase_database_url: "postgresql://postgres.your-project-id:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
  # Pooled connection format (transaction pool)
  # supabase_database_url: "postgresql://postgres.your-project-id:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

  # Option 3: Supabase components (used if no direct URL is provided)
  supabase_url: "https://your-project-id.supabase.co"
  next_public_supabase_url: "https://your-project-id.supabase.co"
  supabase_key: "your-supabase-anon-or-publishable-key"
  supabase_publishable_key: "sb_publishable_your-publishable-key"
  next_public_supabase_publishable_key: "sb_publishable_your-publishable-key"
  supabase_secret_key: "sb_secret_your-secret-key"
  supabase_service_role_key: "your-legacy-service-role-key"
  supabase_project_id: "your-project-id"
  supabase_db_password: "your-database-password"

# Supabase Storage Configuration for receipt file storage
storage:
  bucket_name: "receipts"

# LLM Configuration
llm:
  openai:
    api_key: "your-openai-api-key"
    model: "gpt-5.4-mini"
    temperature: 0.7
  anthropic:
    api_key: "your-anthropic-api-key"
    model: "claude-3-opus"
    temperature: 0.7

# WhatsApp API Configuration
whatsapp:
  phone_number_id: "your-phone-number-id"
  api_version: "v18.0"
  access_token: "your-access-token"

# Logging Configuration
logging:
  level: "INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  file: "logs/app.log"

# Development Settings
development:
  debug: true
