# Optional local YAML configuration.
#
# Prefer `.env` and Vercel environment variables for normal setup. This file is
# only a local template for developers who want to load selected values through
# config/env.py or utils/config.py. Never commit config/env.yaml with real
# secrets.

database:
  database_url: "postgresql://postgres.<project-ref>:<encoded-password>@aws-1-us-west-2.pooler.supabase.com:6543/postgres"
  direct_url: "postgresql://postgres.<project-ref>:<encoded-password>@aws-1-us-west-2.pooler.supabase.com:5432/postgres"
  supabase_url: "https://<project-ref>.supabase.co"
  next_public_supabase_url: "https://<project-ref>.supabase.co"
  supabase_publishable_key: "sb_publishable_..."
  next_public_supabase_publishable_key: "sb_publishable_..."
  supabase_secret_key: "sb_secret_..."
  supabase_project_id: "<project-ref>"
  supabase_db_password: "<database-password>"

storage:
  bucket_name: "receipts"

llm:
  openai:
    api_key: "sk-proj-..."
    model: "gpt-5.4-mini"
    temperature: 0.2

twilio:
  account_sid: "AC..."
  auth_token: "<twilio-auth-token>"
  phone_number: "whatsapp:+1..."

clerk:
  publishable_key: "pk_test_..."
  secret_key: "sk_test_..."
  authorized_parties: "https://whatsapp-invoice-assistant.vercel.app,http://localhost:5001"
  require_auth: true

mongodb:
  uri: "mongodb://localhost:27017/whatsapp_invoice_assistant"
  db_name: "whatsapp_invoice_assistant"
  memory:
    persist_memory: true
    max_memory_age: 86400
    max_messages_per_conversation: 20

logging:
  level: "INFO"
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  file: "logs/app.log"

development:
  debug: true
