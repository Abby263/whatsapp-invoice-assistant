# WhatsApp Invoice Assistant environment
#
# Copy this file to .env for local development. Never commit .env, .env.local,
# Supabase secret keys, Twilio auth tokens, Clerk secrets, or OpenAI API keys.

# Supabase browser-safe project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Supabase server-only database, storage, and vectors
SUPABASE_SECRET_KEY=sb_secret_your_server_side_key
DATABASE_URL=postgresql://postgres.your-project-ref:your_password@aws-0-your-region.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.your-project-ref:your_password@aws-0-your-region.pooler.supabase.com:5432/postgres
SUPABASE_STORAGE_BUCKET=receipts
AUTO_CREATE_DATABASE_SCHEMA=true

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_AUTHORIZED_PARTIES=https://whatsapp-invoice-assistant.vercel.app,http://localhost:5001
CLERK_REQUIRE_AUTH=true

# OpenAI extraction, chat, and embeddings
OPENAI_API_KEY=sk-proj-your_openai_key
OPENAI_API_MODEL=gpt-5.4-mini

# Twilio WhatsApp webhook and media downloads
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=whatsapp:+1your_whatsapp_enabled_twilio_number
TWILIO_OUTBOUND_MESSAGES_ENABLED=true
TWILIO_PROCESSING_ACK_ENABLED=true
TWILIO_PROCESSING_ACK_COOLDOWN_SECONDS=75
TWILIO_PROCESSING_ACK_DATABASE_DEDUPE_ENABLED=true
TWILIO_MEDIA_FINAL_REPLY_ENABLED=true

# Human approval gates
HITL_CONFIRMATION_REQUIRED=true

# Agent conversation memory
CONVERSATION_MEMORY_WINDOW_MESSAGES=12
CONVERSATION_MEMORY_MAX_STORED_MESSAGES=200

# Optional local services
USE_MONGODB=false
MONGODB_URI=mongodb://localhost:27017/whatsapp_invoice_assistant

# App runtime
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0
