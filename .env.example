# WhatsApp Invoice Assistant Environment Variables

# Database Configuration (Supabase only)
# Option 1: Direct connection string for Supabase (primary)
DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres

# Option 2: Alternative Supabase connection formats (uncomment one if needed)
# Direct format alternative
# SUPABASE_DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres
# Pooled connection format (session pool)
# SUPABASE_DATABASE_URL=postgresql://postgres.your-project-id:your_password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Pooled connection format (transaction pool)
# SUPABASE_DATABASE_URL=postgresql://postgres.your-project-id:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Option 3: Supabase components (will be used if no direct URL is provided)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_STORAGE_BUCKET=receipts

# MongoDB for Conversation Memory (optional)
MONGODB_URI=mongodb://localhost:27017/whatsapp_invoice_assistant
USE_MONGODB=true

# OpenAI API for Language Models
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_MODEL=gpt-4o-mini

# WhatsApp API Configuration
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_VERSION=v18.0
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
