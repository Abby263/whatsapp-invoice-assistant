# WhatsApp Invoice Assistant Environment Variables

# Database Configuration (Supabase only)
# Option 1: Direct connection string for Supabase (primary)
DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres

# Option 2: Alternative Supabase connection formats (uncomment one if needed)
# Direct format alternative
# SUPABASE_DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres
# Pooled connection format (session pool)
# SUPABASE_DATABASE_URL=postgresql://postgres.your-project-id:your_password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Pooled connection format (transaction pool)
# SUPABASE_DATABASE_URL=postgresql://postgres.your-project-id:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Option 3: Supabase components (will be used if no direct URL is provided)
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_STORAGE_BUCKET=receipts
SUPABASE_STORAGE_TIMEOUT=30

# Clerk Authentication
# Create an application in Clerk, then copy API keys from Clerk Dashboard > API keys.
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
# Set true in production to require sign-in for receipt, query, and user APIs.
CLERK_REQUIRE_AUTH=false
# Optional hardening. If omitted, the issuer is derived from the publishable key.
CLERK_JWT_ISSUER=
CLERK_JWKS_URL=
# Comma-separated allowed origins for Clerk token azp, for example:
# CLERK_AUTHORIZED_PARTIES=https://whatsapp-invoice-assistant.vercel.app,http://localhost:5001
CLERK_AUTHORIZED_PARTIES=

# MongoDB for Conversation Memory (optional)
MONGODB_URI=mongodb://localhost:27017/whatsapp_invoice_assistant
USE_MONGODB=true

# OpenAI API for Language Models
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_MODEL=gpt-5.4-mini

# WhatsApp API Configuration (for direct Meta Cloud API integrations)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_VERSION=v18.0
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# Twilio Configuration (current webhook payload format)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=whatsapp:+14155238886

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
